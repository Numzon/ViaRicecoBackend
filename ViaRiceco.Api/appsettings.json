{
  "ConnectionStrings": {
    "Database": "",
    "Cache": "",
    "MessageBroker": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "ViaRiceco.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": ""
}
