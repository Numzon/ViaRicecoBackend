{
  "ConnectionStrings": {
    "Database": "Host=viariceco.database;Port=5432;Database=viariceco;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "viariceco.redis:6379",
    "MessageBroker": "rabbitmq://guest:guest@viariceco.rabbitmq:5672"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://viariceco.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "ViaRiceco.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://viariceco.jaeger:4317"
}
